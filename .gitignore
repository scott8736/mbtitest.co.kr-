# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 쿠팡 파트너스 오픈API 키. scripts/coupang-links.mjs 가 읽습니다.
coupang.env

# Pexels 오픈API 키. scripts/pexels-images.mjs 가 읽습니다.
pexels.env

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# 스티커 생성 스크립트의 파이썬 캐시
scripts/__pycache__/

# OG 이미지 생성용 폰트 (10MB). 결과 PNG 만 커밋하므로 폰트는 저장소에 넣지 않는다.
scripts/fonts/
